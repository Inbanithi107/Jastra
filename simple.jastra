FUN small 1 :
    STORE R1 1
    STORE R2 2
    LOAD R1
    PRINT
    LOAD R2
    PRINT
    LOOP:
        INIT:
            STORE R3 2
        COND:
            LOAD R3 LOAD R0 CMP_LT
        BODY:
            LOAD R1
            LOAD R2
            LOAD R2
            PSR R1
            ADD
            PSR R2
            LOAD R2
            PRINT
         UPD:
            LOAD R3
            PUSH 1
            ADD
            PSR R3
    END
    RETURN_VOID

