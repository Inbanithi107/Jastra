GLOBALS {
    name = "Inbanithi";
    age = 21;
    cgpa = 8.37f;
    lib = "simple";
    func = "small";
    table = "tablePrinter";
    array = "array";
    create = "create";
    get = "get";
    set = "set";
}

FUN main 0 :
    STORE R0 18
    LOAD R0
    CALL checkAge 1
    PUSH 'C'
    PUSH 'D'
    ADD
    PRINT
    PUSH 5
    PUSH 20
    CALLE lib table 2
    CALL arr 0
    RETURN_VOID

FUN checkAge 1 :
    LOAD R0
    PUSH 18
    CMP_GE
    JIZ:
        PUSH "You are eligible to vote"
    ELSE:
        PUSH "you are not eligible to vote"
    END
    PRINT
    CALL aboutMe 0
    RETURN_VOID

FUN aboutMe 0 :
    STORE R0 "I'm: "
    STORE R1 "Age: "
    STORE R2 "CGPA: "
    LOAD R2
    LFC cgpa
    ADD
    LOAD R1
    LFC age
    ADD
    LOAD R0
    LFC name
    ADD
    PRINT
    PRINT
    PRINT
    RETURN_VOID

FUN checke 0:
    PUSH 10
    CALLE lib func 1
    RETURN_VOID

FUN arr 0 :
    STORE R0 10
    PUSH "double"
    LOAD R0
    CALLE array create 2
    PSR R1
    LOAD R1
    PUSH 5
    PUSH 36000.0
    CALLE array set 3
    LOAD R1
    PUSH 5
    CALLE array get 2
    PRINT
    RETURN_VOID
