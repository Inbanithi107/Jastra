FUN main 0 :
    STORE R0 17
    LOAD R0
    CALL checkAge 1
    RETURN_VOID

FUN checkAge 1 :
    LOAD R0
    STORE R1 18
    LOAD R1
    CMP_GE
    JIZ:
        STORE R2 "You are eligible to vote"
    ELSE:
        STORE R2 "you are not eligible to vote"
    END
    LOAD R2
    PRINT
    RETURN_VOID
